{
  "name": "mygym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal gym + football training coach (offline-first PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "pages:dev": "wrangler pages dev dist --d1=DB=mygym",
    "db:migrate:local": "wrangler d1 migrations apply mygym --local",
    "db:migrate": "wrangler d1 migrations apply mygym --remote",
    "garmin:scrape": "node scripts/garmin-scrape.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "wrangler": "^3.78.0"
  }
}
